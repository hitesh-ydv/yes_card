<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="16dp"
    app:cardElevation="8dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Card Image with rounded corners -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            >

            <ImageView
                android:id="@+id/imgCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/yes_bank_cc"
                android:scaleType="centerCrop"
                android:contentDescription="card_image" />
        </FrameLayout>

        <!-- Card title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rewards Point Redeem"
            android:textColor="#1A4DBE"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <!-- Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClickHere"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="180dp"
            android:text="Click Here"
            android:textAllCaps="false"
            android:textSize="16sp"

            app:cornerRadius="25dp"
            app:backgroundTint="#1A4DBE"
            android:textColor="#FFFFFF"

            app:iconGravity="end"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>